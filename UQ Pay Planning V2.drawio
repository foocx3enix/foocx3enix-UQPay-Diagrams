        <mxCell id="Q_nuJXuJ8KCzDTo-LM33-146" parent="8LXdY-D83wv9_5kYqO0z-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;" value="failure / reject / exception" vertex="1">
