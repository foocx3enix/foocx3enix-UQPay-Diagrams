        <mxCell id="y9uYIQu13606sEp-yqzD-215" parent="2O8ujgf83aNJrRguQMIG-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="&lt;b&gt;DEVELOPER NOTES&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Self-service path: an account_holder (holds make_transfer_by_client or check_transfer_by_client) applies for their OWN card; another account_holder approves. An NAHC applies via the maker path (CARD_APPLY_NAHC), not here.&lt;br&gt;&lt;br&gt;• The issuance cost is a currency-agnostic number from enix-biz-settings, paid 1:1 in the chosen coin (50 = 50 USDC or 50 USDT), plus the network&#39;s transfer fee.&lt;br&gt;&lt;br&gt;• The onboarding first card is FREE — it skips Phases 1–2 entirely (no card_tasks, no charge) and enters at Phase 3 already in &#39;pending_cardholder&#39;.&lt;br&gt;&lt;br&gt;• An application is invisible to admins until &#39;pending_delivery&#39; — a stuck charge (Phase 2) or a cardholder hold (Phase 3) never appears on the INFII admin pending delivery page.&lt;br&gt;&lt;br&gt;• Our card_limits are the ones we actually enforce at the real-time authorization check — UQPay is only ever told the per-payment max (20,000 USD) and the no-PIN amount." vertex="1">
          <mxGeometry height="321.44" width="560" x="1771.78" y="4572" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="04 - CARD_APPLY_NAHC" id="B3WWdWrJnqzr1dScNejL">
    <mxGraphModel dx="12" dy="-360" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="KVJi7bsxJDHXnZhBuliu-0" />
        <mxCell id="KVJi7bsxJDHXnZhBuliu-1" parent="KVJi7bsxJDHXnZhBuliu-0" />
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-76" parent="KVJi7bsxJDHXnZhBuliu-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="CARD_APPLY_NAHC — a Maker applies for a corporate cardholder (NAHC)&#39;s card (end-to-end)" vertex="1">
          <mxGeometry height="30" width="1100" x="1160.0130399816176" y="821.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-77" parent="KVJi7bsxJDHXnZhBuliu-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=2;" value="The maker path for a corporate cardholder (NAHC = the user-facing name for the same backend role). Structurally identical to CARD_APPLY_SELF — only the initiator (a Maker), the approval stage (a Checker), and the subject user (the target NAHC) differ. Four phases connect top to bottom: Approval → Issuance charge → Cardholder creation → Delivery / assign / activate." vertex="1">
          <mxGeometry height="76" width="1030" x="1160.0130399816176" y="855.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-78" parent="KVJi7bsxJDHXnZhBuliu-1" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1685.0130399816176" y="951.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-79" parent="KVJi7bsxJDHXnZhBuliu-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 1 · APPROVAL — CARD_APPLY_NAHC (one checker stage · maker → checker)" vertex="1">
          <mxGeometry height="820" width="640" x="1380.0130399816176" y="1011.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-80" parent="OZcM1zfR8Zn_qaSWvsLe-79" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;①&amp;nbsp; Create — a Maker applies for a corporate cardholder (NAHC)&#39;s card&lt;/b&gt;&lt;br&gt;&lt;br&gt;• select the target NAHC — only &lt;i&gt;active&lt;/i&gt; NAHC are shown&lt;br&gt;• pick the funding wallet (company cold or cold-plus) — an NAHC has no wallet of their own&lt;br&gt;• pick the coin to pay in: USDC or USDT&lt;br&gt;• pick the delivery address (the NAHC&#39;s personal / company / a new address)&lt;br&gt;• confirm with a one-time code (OTP)" vertex="1">
          <mxGeometry height="150" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-81" parent="OZcM1zfR8Zn_qaSWvsLe-79" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;②&amp;nbsp; Save the request and hold the funds&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_tasks ← insert { subject = CARD_APPLY_NAHC, subject_user_id = target NAHC, card_id = NULL, status = &#39;pending&#39; }&lt;/span&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_task_approvals ← insert { stage = 1, required_approval_role = &#39;checker&#39;, decision = &#39;pending&#39;, assigned_to = NULL }&lt;/span&gt;&amp;nbsp; (the one checker stage)&lt;br&gt;• hold (lock) the issuance cost on the maker-chosen wallet&lt;br&gt;• notify the maker and all of the company&#39;s checkers" vertex="1">
          <mxGeometry height="200" width="580" x="30" y="240" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-82" parent="OZcM1zfR8Zn_qaSWvsLe-79" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;" value="&lt;b&gt;③&amp;nbsp; A checker decides&lt;/b&gt;&lt;br&gt;&lt;br&gt;one-time code on approve;&lt;br&gt;nahc re-checked as still active" vertex="1">
          <mxGeometry height="190" width="440" x="100" y="460" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-83" parent="OZcM1zfR8Zn_qaSWvsLe-79" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;④&amp;nbsp; Approved&lt;/b&gt; — &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_tasks.status ← &#39;approved&#39;&lt;/span&gt; → start execution" vertex="1">
          <mxGeometry height="70" width="580" x="30" y="720" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-84" parent="KVJi7bsxJDHXnZhBuliu-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 2 · ISSUANCE CHARGE — company wallet → card top-up wallet" vertex="1">
          <mxGeometry height="566" width="640" x="1380.0130399816176" y="1891.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-85" parent="OZcM1zfR8Zn_qaSWvsLe-84" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑤&amp;nbsp; Charge the issuance cost&lt;/b&gt; &lt;i&gt;(before the cardholder is created)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• check the maker-chosen wallet still has enough of the chosen coin, plus a little of the network&#39;s own coin to pay the transfer fee&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;create card_applications { status = &#39;pending_issuance_charge&#39;, user_id = target NAHC }&lt;/span&gt;&lt;br&gt;• move the coins: company wallet → card top-up wallet&lt;br&gt;&amp;nbsp;&amp;nbsp; &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;transaction_history + transaction_request&lt;/span&gt;&lt;br&gt;• release the earlier hold on the funds" vertex="1">
          <mxGeometry height="180" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-86" parent="OZcM1zfR8Zn_qaSWvsLe-84" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑥&amp;nbsp; Wait for the transfer to finish on the blockchain&lt;/b&gt;&lt;br&gt;&lt;br&gt;• a confirmed success is what lets the flow continue — not merely sending it" vertex="1">
          <mxGeometry height="90" width="580" x="30" y="290" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-87" parent="OZcM1zfR8Zn_qaSWvsLe-84" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑦&amp;nbsp; Charge confirmed&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  pending_issuance_charge → pending_cardholder&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="580" x="30" y="436" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-88" parent="KVJi7bsxJDHXnZhBuliu-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 3 · CARDHOLDER CREATION (Stage 1 · reuse or create · for the NAHC)" vertex="1">
          <mxGeometry height="536" width="640" x="1380.0130399816176" y="2517.67973058364" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-89" parent="OZcM1zfR8Zn_qaSWvsLe-88" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑧&amp;nbsp; Cardholder — reuse or create&lt;/b&gt;&lt;br&gt;&lt;br&gt;• look the NAHC up by user_id, then by email / phone&lt;br&gt;• if an active cardholder already exists, reuse it (no UQPay call)" vertex="1">
          <mxGeometry height="110" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-90" parent="OZcM1zfR8Zn_qaSWvsLe-88" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑨&amp;nbsp; Create the cardholder at UQPay&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#00499c;&#39;&gt;POST /v1/issuing/cardholders&lt;/span&gt; (waits for the reply)&lt;br&gt;• Simplified KYC — basic profile only, no documents" vertex="1">
          <mxGeometry height="110" width="580" x="30" y="220" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-91" parent="OZcM1zfR8Zn_qaSWvsLe-88" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑩&amp;nbsp; Cardholder is active&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cardholders.status = &#39;active&#39;&lt;/span&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  pending_cardholder → pending_delivery&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="386" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-92" parent="KVJi7bsxJDHXnZhBuliu-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 4 · EXECUTION — delivery → assign → activate (Stages 2–4 · the NAHC completes 3–4)" vertex="1">
          <mxGeometry height="1204" width="668.99" x="1380.01" y="3113.68" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-93" parent="OZcM1zfR8Zn_qaSWvsLe-92" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑪&amp;nbsp; Stage 2 — Delivery&lt;/b&gt; &lt;i&gt;(INFII admin, card-delivery page)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• admin ships the card to the NAHC and records the tracking id + card number&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cards ← insert { internal_status = &#39;pending_assignation&#39;, uqpay_status = NULL, hashed + masked number }&lt;/span&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  pending_delivery → delivered&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-94" parent="OZcM1zfR8Zn_qaSWvsLe-92" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑫&amp;nbsp; Stage 3 — Assign&lt;/b&gt; &lt;i&gt;(the NAHC — card owner)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• the NAHC types in the card number&lt;br&gt;• if another action is already running&amp;nbsp;&amp;nbsp;(inflight_operation NOT NULL)&amp;nbsp;→ error &lt;span style=&quot;font-family:Courier New,monospace;&quot;&gt;409 card_operation_in_progress&lt;/span&gt;&lt;br&gt;• &lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 73, 156);&quot;&gt;POST /v1/issuing/cards/assign&lt;/span&gt; (Assign Card)&lt;br&gt;• saves uqpay_card_id; the card stays pending_assignation" vertex="1">
          <mxGeometry height="160" width="580" x="30" y="270" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-95" parent="OZcM1zfR8Zn_qaSWvsLe-92" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑬&amp;nbsp; Activation code delivered&lt;/b&gt;&lt;br&gt;&lt;br&gt;• UQPay sends the &lt;span style=&#39;font-family:Courier New,monospace;color:#00499c;&#39;&gt;card.activation.code&lt;/span&gt; webhook → we email the code&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cards.internal_status:  pending_assignation → pending_activation&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="486" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-96" parent="OZcM1zfR8Zn_qaSWvsLe-92" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑭&amp;nbsp; Stage 4 — Activate&lt;/b&gt; &lt;i&gt;(the NAHC — card owner)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• the NAHC sets a 6-digit PIN and types the activation code&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#00499c;&#39;&gt;POST /v1/issuing/cards/activate&lt;/span&gt; (Activate Card — waits for the reply)" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="662" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-97" parent="OZcM1zfR8Zn_qaSWvsLe-92" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑮&amp;nbsp; Set the spending limits&lt;/b&gt; &lt;i&gt;(our side first, then one push to UQPay)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_limits + card_channel_limits&lt;/span&gt; — these are the ones we actually enforce&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#00499c;&#39;&gt;one Update Card push&lt;/span&gt; — turn on 3DS, per-payment max 20,000 USD, no-PIN 250 USD&lt;br&gt;• runs in the background; if it fails → card_config_sync_retry admin worklist" vertex="1">
          <mxGeometry height="160" width="580" x="30" y="838" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-98" parent="OZcM1zfR8Zn_qaSWvsLe-92" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑯&amp;nbsp; Card is active  🎉&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cards ← { uqpay_status = &#39;ACTIVE&#39;, internal_status = &#39;active&#39; }&lt;/span&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  delivered → activated&lt;/span&gt;&lt;br&gt;• email the NAHC — the card is ready" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="1054" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-99" parent="KVJi7bsxJDHXnZhBuliu-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Precondition not met → no request created&lt;/b&gt;&lt;br&gt;• the target must be a valid NAHC (holds initiate_card_top_up_without_wallet) AND active — else 403 invalid_target_user&lt;br&gt;• at most 1 active card AND 1 active application (for the target NAHC)&lt;br&gt;• the maker-chosen wallet must have enough funds&lt;br&gt;• otherwise refused right away — no card_tasks row, no hold" vertex="1">
          <mxGeometry height="140" width="360" x="2100.0130399816176" y="1065.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-100" parent="KVJi7bsxJDHXnZhBuliu-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Cancel (maker only)&lt;/b&gt;&lt;br&gt;• allowed only before a checker picks it up&lt;br&gt;• status = &#39;cancelled&#39;, release the hold" vertex="1">
          <mxGeometry height="90" width="360" x="2100.0130399816176" y="1271.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-101" parent="KVJi7bsxJDHXnZhBuliu-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Rejected, or subject no longer active&lt;/b&gt;&lt;br&gt;• nahc status is not active at approval → 403 invalid_target_user; the checker rejects it (no auto-cancel)&lt;br&gt;• status = &#39;rejected&#39;, release the hold&lt;br&gt;• notify the maker and stop — nothing was charged" vertex="1">
          <mxGeometry height="130" width="360" x="2100.0130399816176" y="1441.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-102" parent="KVJi7bsxJDHXnZhBuliu-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Subject switched NAHC → account holder mid-request? Still issued.&lt;/b&gt;&lt;br&gt;• the NAHC role is checked ONCE, at creation, and never again&lt;br&gt;• the request is NOT cancelled and no stage is cleared — the checker still approves and the card is issued&lt;br&gt;• only the nahc&#39;s status (active / blocked) is re-checked at approval" vertex="1">
          <mxGeometry height="150" width="360" x="2100.0130399816176" y="1671.6797305836396" as="geometry" />
        </mxCell>
        <mxCell id="OZcM1zfR8Zn_qaSWvsLe-103" parent="KVJi7bsxJDHXnZhBuliu-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Charge fails (can&#39;t send, or fails on the blockchain)&lt;/b&gt;&lt;br&gt;• the application stays stuck in &#39;pending_issuance_charge&#39;&lt;br&gt;• retried through the existing Hextrust transfer tools — never shown on a card screen" vertex="1">
          <mxGeometry height="120" width="360" x="2100.0130399816176" y="2191.67973058364" as="geometry" />
        </mxCell>
