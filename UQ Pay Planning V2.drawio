        <mxCell id="l6hcsCRDCBBhjLUVyptU-59" edge="1" parent="0BOv6G7DclFDWjEQHEvZ-1" source="l6hcsCRDCBBhjLUVyptU-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="l6hcsCRDCBBhjLUVyptU-31" value="UQPay rejects">
