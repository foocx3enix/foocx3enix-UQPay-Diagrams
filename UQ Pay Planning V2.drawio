        </mxCell>
        <mxCell id="NdQ8E3cr2_pZKo9tdT5M-89" parent="NdQ8E3cr2_pZKo9tdT5M-88" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingRight=12;spacingTop=8;" value="Initiator: a Maker, OR a corporate cardholder (NAHC)&#xa;Approver: a Checker&#xa;&#xa;Maker-initiated: NAHC_INVITE, NAHC_SUSPEND,&#xa;NAHC_UNSUSPEND, CARD_APPLY_NAHC,&#xa;CARD_REPLACE_NAHC, CARD_TOPUP_NAHC_BY_MAKER&#xa;&#xa;NAHC-initiated: CARD_UNFREEZE_NAHC,&#xa;CARD_LIMIT_UPDATE_NAHC, CARD_CLOSE_NAHC,&#xa;CARD_REMOVE_NAHC" vertex="1">
          <mxGeometry height="190" width="460" y="30" as="geometry" />
        </mxCell>
        <mxCell id="NdQ8E3cr2_pZKo9tdT5M-90" parent="UZv5MCVZXhOqA6S8-3Av-1" style="swimlane;html=1;rounded=1;arcSize=6;startSize=30;fontSize=12;fontStyle=1;fontColor=#ffffff;align=center;verticalAlign=middle;fillColor=#d79b00;strokeColor=#d79b00;swimlaneFillColor=#ffffff;" value="TWO STAGES  ·  [ maker → checker ]" vertex="1">
          <mxGeometry height="205" width="460" x="2185.895392922794" y="1542.1503188189338" as="geometry" />
        </mxCell>
        <mxCell id="NdQ8E3cr2_pZKo9tdT5M-91" parent="NdQ8E3cr2_pZKo9tdT5M-90" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;spacingLeft=12;spacingRight=12;spacingTop=8;" value="Initiator: a corporate cardholder (NAHC)&#xa;&#xa;Stage 1 — maker: ENRICHES the request (selects&#xa;USDC / USDT, locks the top-up quotation), then approves&#xa;&#xa;Stage 2 — checker: final decision against the&#xa;locked amounts&#xa;&#xa;Subject: CARD_TOPUP_NAHC" vertex="1">
          <mxGeometry height="175" width="460" y="30" as="geometry" />
        </mxCell>
        <mxCell id="NdQ8E3cr2_pZKo9tdT5M-92" parent="UZv5MCVZXhOqA6S8-3Av-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" value="NAHC = &quot;Corporate Cardholder&quot; — the user-facing name for the same backend role." vertex="1">
          <mxGeometry height="30" width="460" x="2185.895392922794" y="1756.1503188189338" as="geometry" />
        </mxCell>
        <mxCell id="NdQ8E3cr2_pZKo9tdT5M-93" parent="UZv5MCVZXhOqA6S8-3Av-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;align=left;verticalAlign=top;spacingLeft=12;spacingRight=12;spacingTop=10;" value="DEVELOPER NOTES&lt;br&gt;&lt;br&gt;• Internal OTP applies to every subject EXCEPT freeze. A wrong or expired code changes nothing — the person is simply re-prompted, within the attempt cap.&lt;br&gt;&lt;br&gt;• The initiator can only ever CANCEL their own request — never approve it.&lt;br&gt;&lt;br&gt;• ApprovalFlows[subject] is a Go map, not a DB table; it is copied into card_task_approvals rows when the request is created.&lt;br&gt;&lt;br&gt;• Roles are matched POSITIVELY, by permission:&amp;nbsp;&lt;div&gt;account_holder = user that holds make_transfer_by_client or check_transfer_by_client;&amp;nbsp;&lt;/div&gt;&lt;div&gt;NAHC = holds initiate_card_top_up_without_wallet.&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Never inferred from the absence of the other.&lt;br&gt;&lt;br&gt;&lt;br&gt;• Admin card actions (unfreeze / close / remove / limit-update / activation-reset) run on the SEPARATE permissions_tasks maker→checker engine — different tables, out of scope here.&lt;/div&gt;" vertex="1">
          <mxGeometry height="306.15" width="746.1" x="2185.9" y="1856" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="03 - CARD_APPLY_SELF" id="a3xqDQAERRA9CxUWalrg">
    <mxGraphModel dx="2145" dy="1195" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="2O8ujgf83aNJrRguQMIG-0" />
        <mxCell id="2O8ujgf83aNJrRguQMIG-1" parent="2O8ujgf83aNJrRguQMIG-0" />
        <mxCell id="y9uYIQu13606sEp-yqzD-144" parent="2O8ujgf83aNJrRguQMIG-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="CARD_APPLY_SELF — an account holder applies for their own card (end-to-end)" vertex="1">
          <mxGeometry height="30" width="1000" x="1091.7777458639707" y="753.4444364659928" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-145" parent="2O8ujgf83aNJrRguQMIG-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;spacing=2;" value="Four phases connect top to bottom: Approval → Issuance charge → Cardholder creation → Delivery / assign / activate. NAHC applies via the maker path (CARD_APPLY_NAHC), not here." vertex="1">
          <mxGeometry height="60" width="1000" x="1091.7777458639707" y="787.4444364659928" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-146" parent="2O8ujgf83aNJrRguQMIG-1" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1616.7777458639707" y="873.4444364659928" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-147" parent="2O8ujgf83aNJrRguQMIG-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 1 · APPROVAL — CARD_APPLY_SELF" vertex="1">
          <mxGeometry height="800" width="640" x="1311.7777458639707" y="933.4444364659928" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-148" parent="y9uYIQu13606sEp-yqzD-147" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;①&amp;nbsp; Create — the account holder applies for their own card&lt;/b&gt;&lt;br&gt;&lt;br&gt;• pick the funding wallet (company cold or cold-plus)&lt;br&gt;• pick the coin to pay in: USDC or USDT&lt;br&gt;• pick the delivery address&lt;br&gt;• confirm with a one-time code (OTP)" vertex="1">
          <mxGeometry height="130" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-149" parent="y9uYIQu13606sEp-yqzD-147" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;②&amp;nbsp; Save the request and hold the funds&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, monospace; color: rgb(122, 59, 156);&quot;&gt;card_tasks ← insert { subject = CARD_APPLY_SELF, status = &#39;pending&#39; }&lt;/span&gt;&lt;div&gt;•&amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font color=&quot;#7a3b9c&quot; face=&quot;Courier New, monospace&quot;&gt;card_task_approvals ← insert { task_id, stage = 1, required_approval_role = &#39;account_holder&#39;, decision = &#39;pending&#39;, assigned_to = NULL }&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;• hold (lock) the issuance cost on the chosen wallet&lt;br&gt;• notify the company&#39;s other account holders&lt;/div&gt;" vertex="1">
          <mxGeometry height="150" width="580" x="30" y="240" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-150" parent="y9uYIQu13606sEp-yqzD-147" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;spacing=6;" value="&lt;b&gt;③&amp;nbsp; Another account holder decides&lt;/b&gt;&lt;br&gt;&lt;br&gt;one-time code on approve;&lt;br&gt;re-checked applicant user.status as still active" vertex="1">
          <mxGeometry height="190" width="440" x="100" y="450" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-151" parent="y9uYIQu13606sEp-yqzD-147" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;④&amp;nbsp; Approved&lt;/b&gt; — &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_tasks.status ← &#39;approved&#39;&lt;/span&gt; → start execution" vertex="1">
          <mxGeometry height="70" width="580" x="30" y="700" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-152" parent="2O8ujgf83aNJrRguQMIG-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 2 · ISSUANCE CHARGE — customer wallet → card top-up wallet" vertex="1">
          <mxGeometry height="566" width="640" x="1311.7777458639707" y="1793.4444364659928" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-153" parent="y9uYIQu13606sEp-yqzD-152" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑤&amp;nbsp; Charge the issuance cost&lt;/b&gt; &lt;i&gt;(before the cardholder is created)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• check the wallet still has enough balance of the chosen coin &amp;amp; gas fee&lt;br&gt;• &lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, monospace; color: rgb(122, 59, 156);&quot;&gt;create card_applications { status = &#39;pending_issuance_charge&#39; }&lt;/span&gt;&lt;br&gt;• move the coins: customer wallet → card top-up wallet&lt;br&gt;&amp;nbsp;&amp;nbsp; &lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, monospace; color: rgb(122, 59, 156);&quot;&gt;transaction_history + transaction_request&lt;/span&gt;&lt;br&gt;• release the earlier hold on the funds" vertex="1">
          <mxGeometry height="180" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-154" parent="y9uYIQu13606sEp-yqzD-152" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑥&amp;nbsp; Wait for the transfer to finish on the blockchain&lt;/b&gt;&lt;br&gt;&lt;br&gt;• a confirmed success is what lets the flow continue — not merely sending it" vertex="1">
          <mxGeometry height="90" width="580" x="30" y="290" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-155" parent="y9uYIQu13606sEp-yqzD-152" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑦&amp;nbsp; Charge confirmed&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  pending_issuance_charge → pending_cardholder&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="580" x="30" y="436" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-156" parent="2O8ujgf83aNJrRguQMIG-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 3 · CARDHOLDER CREATION (Stage 1 · reuse or create)" vertex="1">
          <mxGeometry height="536" width="640" x="1311.7777458639707" y="2419.444436465993" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-157" parent="y9uYIQu13606sEp-yqzD-156" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑧&amp;nbsp; Cardholder — reuse or create&lt;/b&gt;&lt;br&gt;&lt;br&gt;• look the person up by user_id, then by email / phone&lt;br&gt;• if an active cardholder already exists, reuse it (no UQPay call)" vertex="1">
          <mxGeometry height="110" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-158" parent="y9uYIQu13606sEp-yqzD-156" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑨&amp;nbsp; Create the cardholder at UQPay&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#00499c;&#39;&gt;POST /v1/issuing/cardholders&lt;/span&gt; (waits for the reply)&lt;br&gt;• Simplified KYC — basic profile only, no documents" vertex="1">
          <mxGeometry height="110" width="580" x="30" y="220" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-159" parent="y9uYIQu13606sEp-yqzD-156" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑩&amp;nbsp; Cardholder is active&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cardholders.status = &#39;active&#39;&lt;/span&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  pending_cardholder → pending_delivery&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="386" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-160" parent="2O8ujgf83aNJrRguQMIG-1" style="swimlane;html=1;rounded=1;arcSize=2;startSize=46;fontSize=14;fontStyle=1;fontColor=#ffffff;align=left;verticalAlign=middle;spacingLeft=16;fillColor=#44546a;strokeColor=#44546a;swimlaneFillColor=#f7f9fc;" value="PHASE 4 · EXECUTION — delivery → assign → activate (Stages 2–4)" vertex="1">
          <mxGeometry height="1204" width="640" x="1311.7777458639707" y="3015.444436465993" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-161" parent="y9uYIQu13606sEp-yqzD-160" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑪&amp;nbsp; Stage 2 — Delivery&lt;/b&gt; &lt;i&gt;(INFII admin, card-delivery page)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• admin ships the card and records the tracking id + card number&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cards ← insert { internal_status = &#39;pending_assignation&#39;, uqpay_status = NULL, hashed + masked number }&lt;/span&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  pending_delivery → delivered&lt;/span&gt;" vertex="1">
          <mxGeometry height="160" width="580" x="30" y="54" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-162" parent="y9uYIQu13606sEp-yqzD-160" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑫&amp;nbsp; Stage 3 — Assign&lt;/b&gt; &lt;i&gt;(the card owner)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• owner types in the card number&lt;br&gt;• if another card action is already running (inflight_operation NOT NULL)&amp;nbsp; → error &lt;span style=&quot;font-family:Courier New,monospace;&quot;&gt;409 card_operation_in_progress&lt;/span&gt;&lt;br&gt;• &lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 73, 156);&quot;&gt;POST /v1/issuing/cards/assign&lt;/span&gt; (Assign Card)&lt;br&gt;• saves uqpay_card_id; the card stays pending_assignation" vertex="1">
          <mxGeometry height="160" width="580" x="30" y="270" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-163" parent="y9uYIQu13606sEp-yqzD-160" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑬&amp;nbsp; Activation code delivered&lt;/b&gt;&lt;br&gt;&lt;br&gt;• UQPay sends the &lt;span style=&#39;font-family:Courier New,monospace;color:#00499c;&#39;&gt;card.activation.code&lt;/span&gt; webhook → we email the code&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cards.internal_status:  pending_assignation → pending_activation&lt;/span&gt;" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="486" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-164" parent="y9uYIQu13606sEp-yqzD-160" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑭&amp;nbsp; Stage 4 — Activate&lt;/b&gt; &lt;i&gt;(the card owner)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• owner sets a 6-digit PIN and types the activation code&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#00499c;&#39;&gt;POST /v1/issuing/cards/activate&lt;/span&gt; (Activate Card — waits for the reply)" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="662" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-165" parent="y9uYIQu13606sEp-yqzD-160" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑮&amp;nbsp; Set the spending limits&lt;/b&gt; &lt;i&gt;(our side first, then one push to UQPay)&lt;/i&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, monospace; color: rgb(122, 59, 156);&quot;&gt;card_limits + card_channel_limits&lt;/span&gt; — these are the ones we actually enforce&lt;br&gt;• &lt;span style=&quot;font-family: &amp;quot;Courier New&amp;quot;, monospace; color: rgb(0, 73, 156);&quot;&gt;one Update Card push&lt;/span&gt; — turn on 3DS, per-payment max 20,000 USD, no-PIN 250 USD&lt;br&gt;• runs in the background; if it fails → card_config_sync_retry admin worklist" vertex="1">
          <mxGeometry height="160" width="580" x="30" y="838" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-166" parent="y9uYIQu13606sEp-yqzD-160" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;" value="&lt;b&gt;⑯&amp;nbsp; Card is active  🎉&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;cards ← { uqpay_status = &#39;ACTIVE&#39;, internal_status = &#39;active&#39; }&lt;/span&gt;&lt;br&gt;• &lt;span style=&#39;font-family:Courier New,monospace;color:#7a3b9c;&#39;&gt;card_applications.status:  delivered → activated&lt;/span&gt;&lt;br&gt;• email the user — the card is ready" vertex="1">
          <mxGeometry height="120" width="580" x="30" y="1054" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-167" parent="2O8ujgf83aNJrRguQMIG-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Precondition not met → no request created&lt;/b&gt;&lt;br&gt;• at most 1 active card AND at most 1 active application (per user)&lt;br&gt;• the chosen wallet must have enough funds&lt;br&gt;• otherwise refused right away — no card_tasks row, no hold" vertex="1">
          <mxGeometry height="120" width="360" x="2031.7777458639707" y="987.4444364659928" as="geometry" />
        </mxCell>
        <mxCell id="y9uYIQu13606sEp-yqzD-168" parent="2O8ujgf83aNJrRguQMIG-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=8;" value="&lt;b&gt;Cancel (applicant only)&lt;/b&gt;&lt;br&gt;• allowed only before anyone picks it up&lt;br&gt;• status = &#39;cancelled&#39;, release the hold" vertex="1">
          <mxGeometry height="90" width="360" x="2031.7777458639707" y="1183.4444364659928" as="geometry" />
        </mxCell>
