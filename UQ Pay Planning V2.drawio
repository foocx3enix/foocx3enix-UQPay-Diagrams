        <mxCell id="Q_nuJXuJ8KCzDTo-LM33-134" parent="8LXdY-D83wv9_5kYqO0z-1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" value="Fee waterfall — computed and LOCKED on the request at creation" vertex="1">
          <mxGeometry height="26" width="700" x="2797.370279947918" y="5853.5927734375" as="geometry" />
        </mxCell>
        <mxCell id="Q_nuJXuJ8KCzDTo-LM33-135" parent="8LXdY-D83wv9_5kYqO0z-1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#f9f9f9;strokeColor=#cccccc;spacing=12;spacingLeft=14;" value="F&amp;nbsp; = card credit — the amount that lands on the card&#xa;D&amp;nbsp; = amount charged / deducted from the wallet&amp;nbsp; = F / (1 − B)&amp;nbsp;&amp;nbsp; (max-spend mode: enter D, then F = D × (1 − B))&#xa;G&amp;nbsp; = amount forwarded to the UQPay ramp&amp;nbsp; = F / ((1 − C)(1 − A))&#xa;I&amp;nbsp;&amp;nbsp; = after off-ramp, sitting in the ramp account&amp;nbsp; = G × (1 − A)&#xa;K&amp;nbsp; = after VA-to-card (reconciles back to F)&amp;nbsp; = I × (1 − C)&#xa;net_revenue&amp;nbsp; = D − G&amp;nbsp;&amp;nbsp; (kept in the card top-up wallet, never forwarded)&#xa;&#xa;B = 1.9% INFII (0.50% top-up + 1.40% conversion)&amp;nbsp; ·&amp;nbsp; A = 0.25% off-ramp&amp;nbsp; ·&amp;nbsp; C = 1% VA-to-card&#xa;All amounts are executed exactly as locked — never recomputed downstream." vertex="1">
          <mxGeometry height="230" width="640" x="2797.370279947918" y="5885.5927734375" as="geometry" />
        </mxCell>
        <mxCell id="Q_nuJXuJ8KCzDTo-LM33-136" parent="8LXdY-D83wv9_5kYqO0z-1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=14;fontStyle=1;" value="Status fields that move through the flow" vertex="1">
          <mxGeometry height="26" width="640" x="2797.370279947918" y="6143.5927734375" as="geometry" />
        </mxCell>
        <mxCell id="Q_nuJXuJ8KCzDTo-LM33-137" parent="8LXdY-D83wv9_5kYqO0z-1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fillColor=#f9f9f9;strokeColor=#cccccc;spacing=12;spacingLeft=14;" value="card_tasks.status:&amp;nbsp; pending → approved&amp;nbsp; (or rejected / cancelled)&#xa;&#xa;deposit_requests.status (customer-facing):&amp;nbsp; pending → success&#xa;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; (&#39;failed&#39; is reserved for a non-retryable request; no step sets it today)&#xa;&#xa;deposit_requests.pipeline_status (internal stage + concurrency guard):&#xa;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; pending_deposit_into_topup_wallet → pending_deposit_into_ramp_account&#xa;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; → (pending_travel_rule) → pending_offramp_conversion → pending_ramp_to_banking_transfer&#xa;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; → pending_bank_to_issuing_settlement → pending_bank_to_issuing_settlement_approval&#xa;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; → pending_card_recharge → recharged" vertex="1">
          <mxGeometry height="230" width="640" x="2797.370279947918" y="6175.5927734375" as="geometry" />
        </mxCell>
        <mxCell id="Q_nuJXuJ8KCzDTo-LM33-138" parent="8LXdY-D83wv9_5kYqO0z-1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;" value="Legend" vertex="1">
          <mxGeometry height="24" width="285" x="2797.370279947918" y="6433.5927734375" as="geometry" />
        </mxCell>
