        <mxCell id="daHSXicIUf_iNyanYbEl-46" edge="1" parent="fdiY78E_wBlVqpb2p_Ax-1" source="daHSXicIUf_iNyanYbEl-12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="daHSXicIUf_iNyanYbEl-25" value="stuck">
